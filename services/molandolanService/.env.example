IS_LOCAL=true
ENV=development
LOG_LEVEL=info
PORT=18083

# Database
MYSQL_USER=root
MYSQL_PASSWORD=rootpassword
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3307
